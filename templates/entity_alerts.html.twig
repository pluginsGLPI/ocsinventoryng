{# OCS alerts of an entity (OcsAlert::showNotificationOptions(), tab of the entity) #}
{% import 'components/form/fields_macros.html.twig' as fields %}

<form method="post" action="{{ form_url }}" class="card mb-3">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="entities_id" value="{{ entities_id }}">
    {% if id > 0 %}<input type="hidden" name="id" value="{{ id }}">{% endif %}

    <div class="card-header">
        <h3 class="card-title"><i class="ti ti-bell me-2"></i>{{ __('OCS-NG Synchronization alerts', 'ocsinventoryng') }}</h3>
    </div>
    <div class="card-body">
        <div class="row">
            {% set options = {'full_width': true, 'label_class': 'col-md-5', 'input_class': 'col-md-7', 'disabled': not canedit} %}
            {{ fields.dropdownArrayField('use_newocs_alert', use_newocs_alert, days, __('New imported computers from OCS-NG', 'ocsinventoryng'), options) }}
            {{ fields.dropdownArrayField('delay_ocs', delay_ocs, days, __('Computers not synchronized with OCS-NG since more', 'ocsinventoryng'), options) }}
        </div>
    </div>
    {% if canedit %}
        <div class="card-footer text-end">
            <button type="submit" name="{{ id > 0 ? 'update' : 'add' }}" value="1" class="btn btn-primary">
                <i class="ti ti-device-floppy me-1"></i>{{ _x('button', 'Save') }}
            </button>
        </div>
    {% endif %}
</form>
