{# Rights of the plugin in a profile (Profile::showForm()): the rights matrix of the core, given
   as HTML by Profile::displayRightsChoiceMatrix() #}
{% if canedit and openform %}
<form method="post" action="{{ form_url }}">
{% endif %}
    {{ matrix|raw }}
{% if canedit and closeform %}
    <input type="hidden" name="id" value="{{ profiles_id }}">
    <div class="text-center my-2">
        <button type="submit" name="update" value="1" class="btn btn-primary">
            <i class="ti ti-device-floppy me-1"></i>{{ _x('button', 'Save') }}
        </button>
    </div>
{% endif %}
{% if canedit and openform %}
</form>
{% endif %}
