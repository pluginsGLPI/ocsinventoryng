{# Plugin setup (Config::showForm(), Config::showFormAutomaticSynchronization()):
   one card, the fields given by the PHP side #}
{% import 'components/form/fields_macros.html.twig' as fields %}

<form method="post" action="{{ form_url }}" class="card mb-3">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="id" value="1">

    <div class="card-header">
        <h3 class="card-title"><i class="{{ icon }} me-2"></i>{{ title }}</h3>
    </div>
    <div class="card-body">
        <div class="row">
            {% for field in form_fields %}
                {% set options = {'full_width': true, 'label_class': 'col-md-5', 'input_class': 'col-md-7'}|merge(field.options ?? {}) %}
                {% if field.type == 'yesno' %}
                    {{ fields.dropdownYesNo(field.name, field.value, field.label, options) }}
                {% elseif field.type == 'number' %}
                    {{ fields.numberField(field.name, field.value, field.label, options) }}
                {% elseif field.type == 'alert' %}
                    {{ fields.dropdownArrayField(field.name, field.value, field.values, field.label, options) }}
                {% elseif field.type == 'textarea' %}
                    {{ fields.textareaField(field.name, field.value, field.label, options) }}
                {% endif %}
            {% endfor %}
        </div>
    </div>
    {% if canedit %}
        <div class="card-footer text-end">
            <button type="submit" name="update" value="1" class="btn btn-primary">
                <i class="ti ti-device-floppy me-1"></i>{{ _x('button', 'Save') }}
            </button>
        </div>
    {% endif %}
</form>
