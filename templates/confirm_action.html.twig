{# Confirmation of an action of the plugin (front/deleted_equiv.php): the action is started by the
   POST of this form, which carries the CSRF token, never by a link #}
<div class="container-lg my-3">
    <form method="post" action="{{ form_url }}" class="card">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
        <div class="card-body text-center py-5">
            <span class="avatar avatar-xl bg-orange-lt mb-3"><i class="ti {{ icon }} fs-1"></i></span>
            <h2 class="mb-2">{{ title }}</h2>
            {% for line in lines %}
                <div class="text-secondary">{{ line }}</div>
            {% endfor %}
            <div class="mt-4">
                <button type="submit" name="{{ name }}" value="1" class="btn btn-primary me-1">
                    <i class="ti {{ icon }} me-1"></i>{{ button }}
                </button>
                <a href="{{ back.url }}" class="btn btn-outline-secondary">
                    <i class="ti {{ back.icon }} me-1"></i>{{ back.title }}
                </a>
            </div>
        </div>
    </form>
</div>
