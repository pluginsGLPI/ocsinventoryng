{# Choice of the subnets of the IPDiscover lists (IpdiscoverOcslink::showSubnetSearchForm()) #}
{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="{{ column_class ?? 'container-lg my-3' }}">
<form method="post" action="{{ form_url }}" class="card h-100">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <div class="card-header">
        <h3 class="card-title"><i class="ti {{ icon }} me-2"></i>{{ title }}</h3>
    </div>
    <div class="card-body">
        <div class="row">
            {{ fields.dropdownArrayField('subnetsChoice', 0, subnets, __('Subnet'), {
                'on_change': 'this.form.submit()',
                'full_width': true,
            }) }}
        </div>
    </div>
</form>
</div>
