{# IPDiscover tab of the plugin menu (IpdiscoverOcslink::ipDiscoverMenu()): the choices of the
   subnets to import and to link, side by side #}
<div class="container-lg my-3">
    <div class="row row-cards g-3">
        {% for choice in choices %}
            {{ include('@ocsinventoryng/ipdiscover_subnet_choice.html.twig', choice|merge({'column_class': 'col-12 col-lg-6'}), with_context = false) }}
        {% endfor %}
    </div>
</div>
