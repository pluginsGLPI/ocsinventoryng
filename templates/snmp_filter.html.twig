{# Filter of the SNMP lists to import or link (SnmpOcslink::searchForm()) #}
{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="container-fluid mt-3">
    <form method="post" action="{{ form_url }}" class="card">
        <div class="card-header">
            <h3 class="card-title"><i class="ti ti-filter me-2"></i>{{ __('Filter SNMP Objects list', 'ocsinventoryng') }}</h3>
        </div>
        <div class="card-body">
            <div class="row align-items-center">
                {{ fields.dropdownArrayField('itemtype', itemtype, itemtypes, __('By itemtype', 'ocsinventoryng'), {
                    'display_emptychoice': true,
                }) }}
                {{ fields.textField('ip', ip, __('By IP', 'ocsinventoryng')) }}
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" name="search" value="1" class="btn btn-primary">
                <i class="ti ti-search me-1"></i>{{ _x('button', 'Post') }}
            </button>
            <a href="{{ form_url }}?reset=reset" class="btn btn-outline-secondary">
                <i class="ti ti-filter-off me-1"></i>{{ __('Blank') }}
            </a>
        </div>
    </form>
</div>
