{# OCS link of a computer (Ocslink::showForItem()): its data, the automatic update setting, the
   synchronization actions, and the OCS data of the computer in debug mode #}
{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title"><i class="ti ti-link me-2"></i>{{ __('OCSNG link', 'ocsinventoryng') }}</h3>
    </div>
    {% if link is null %}
        <div class="card-body text-secondary">{{ __('No computer found into OCSNG Database', 'ocsinventoryng') }}</div>
    {% else %}
        <form method="post" action="{{ form_url }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="id" value="{{ items_id }}">
            <input type="hidden" name="items_id" value="{{ items_id }}">
            <input type="hidden" name="link_id" value="{{ link.id }}">
            <input type="hidden" name="resynch_id" value="{{ link.id }}">
            <div class="card-body">
                <div class="row">
                    {{ fields.htmlField('', link.ocs_deviceid|e, __('OCSNG DEVICE ID', 'ocsinventoryng')) }}
                    {{ fields.htmlField('', link.tag|e, __('OCSNG TAG', 'ocsinventoryng')) }}
                    {{ fields.dropdownYesNo('use_auto_update', link.use_auto_update, __('Automatic update OCSNG', 'ocsinventoryng'), {
                        'disabled': not canedit,
                    }) }}
                    {{ fields.htmlField('', link.uptime|e, __('Uptime', 'ocsinventoryng')) }}
                    {{ fields.htmlField('', checksum|e, __('Checksum', 'ocsinventoryng')) }}
                </div>
            </div>
            {% if canedit %}
                <div class="card-footer d-flex flex-wrap gap-2">
                    <button type="submit" name="update" value="1" class="btn btn-primary">
                        <i class="ti ti-device-floppy me-1"></i>{{ _x('button', 'Save') }}
                    </button>
                    <button type="submit" name="launch_ocs_resynch" value="1" class="btn btn-outline-primary">
                        <i class="ti ti-refresh me-1"></i>{{ _x('button', 'Launch synchronization', 'ocsinventoryng') }}
                    </button>
                    <button type="submit" name="force_ocs_resynch" value="1" class="btn btn-outline-primary">
                        <i class="ti ti-download me-1"></i>{{ _x('button', 'Force full import', 'ocsinventoryng') }}
                    </button>
                    {% if can_delete %}
                    <button type="submit" name="delete_link" value="1" class="btn btn-outline-danger ms-auto"
                            onclick="return confirm('{{ __('Confirm the final deletion?')|e('js') }}');">
                        <i class="ti ti-unlink me-1"></i>{{ _x('button', 'Delete link', 'ocsinventoryng') }}
                    </button>
                    {% endif %}
                </div>
            {% endif %}
        </form>
    {% endif %}
</div>

{% if debug is not null %}
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title"><i class="ti ti-bug me-2"></i>{{ __('DEBUG') }} {{ __('OCSNG', 'ocsinventoryng') }}</h3>
        </div>
        {% if debug.sections is empty %}
            <div class="card-body text-danger">{{ __('No computer found into OCSNG Database', 'ocsinventoryng') }}</div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-sm card-table">
                    {% for section, values in debug.sections %}
                        <tr>
                            <th class="w-25">{{ section }}</th>
                            <td>
                                {% for name, value in values %}
                                    {% if value is iterable %}
                                        <div class="border-start ps-2 mb-1">
                                            {% for k, v in value %}<div>{{ k }}: {{ v }}</div>{% endfor %}
                                        </div>
                                    {% else %}
                                        <div>{{ name }}: {{ value }}</div>
                                    {% endif %}
                                {% endfor %}
                            </td>
                        </tr>
                    {% endfor %}
                    {% if debug.checksum_test is not null %}
                        <tr>
                            <th>{{ __('Checksum test', 'ocsinventoryng') }}</th>
                            <td><code>{{ debug.checksum_test }}</code></td>
                        </tr>
                    {% endif %}
                </table>
            </div>
        {% endif %}
    </div>
{% endif %}
