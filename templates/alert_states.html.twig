{# Statuses used for the alerts (OcsAlert::configCron()): add a status; the list is
   NotificationState::configState() #}
{% import 'components/form/fields_macros.html.twig' as fields %}

<form method="post" action="{{ form_url }}" class="card mb-3">
    <div class="card-header">
        <h3 class="card-title"><i class="ti ti-bell me-2"></i>{{ __('Statuses used for alert', 'ocsinventoryng') }}</h3>
    </div>
    <div class="card-body">
        <div class="row">
            {{ fields.dropdownField('State', 'states_id', 0, __('Status'), {
                'used': used,
                'full_width': true,
                'label_class': 'col-md-3',
                'input_class': 'col-md-9',
            }) }}
        </div>
    </div>
    <div class="card-footer text-end">
        <button type="submit" name="add_state" value="1" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i>{{ _x('button', 'Add') }}
        </button>
    </div>
</form>
